{
  "//": "firestore.indexes.json — UNIAO dos indices das codebases colecoes e torneios. Billing nao declara indice. Cada entrada guarda sua origem.",
  "indexes": [
    {
      "//": "Vitrine/inventario: itens de uma colecao, mais recentes primeiro. Usado ao abrir a aba do Kit Pioneiros no inventario do jogador. [origem: colecoes/kit-pioneiros]",
      "collectionGroup": "inventory",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "collectionId",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "unlockedAt",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "//": "Perfil/mesa: o que o jogador tem equipado agora, por colecao. Consulta pequena e frequente. [origem: colecoes/kit-pioneiros]",
      "collectionGroup": "inventory",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "equipped",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "collectionId",
          "order": "ASCENDING"
        }
      ]
    },
    {
      "//": "Suporte/auditoria: quem resgatou uma campanha, em ordem cronologica. COLLECTION_GROUP porque campaign_claims vive sob cada usuario. [origem: colecoes/kit-pioneiros]",
      "collectionGroup": "campaign_claims",
      "queryScope": "COLLECTION_GROUP",
      "fields": [
        {
          "fieldPath": "campaignId",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "claimedAt",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "//": "Central de torneios: edicoes visiveis por status, mais proximas primeiro. [origem: torneios/v1]",
      "collectionGroup": "editions",
      "queryScope": "COLLECTION_GROUP",
      "fields": [
        {
          "fieldPath": "status",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "inicioPrevisto",
          "order": "ASCENDING"
        }
      ]
    },
    {
      "//": "Agendador: edicoes cuja janela de inscricao ja abriu e que ainda nao abriram. [origem: torneios/v1]",
      "collectionGroup": "editions",
      "queryScope": "COLLECTION_GROUP",
      "fields": [
        {
          "fieldPath": "status",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "inscricoesAbremEm",
          "order": "ASCENDING"
        }
      ]
    },
    {
      "//": "Agendador: edicoes cuja janela de inscricao venceu. [origem: torneios/v1]",
      "collectionGroup": "editions",
      "queryScope": "COLLECTION_GROUP",
      "fields": [
        {
          "fieldPath": "status",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "inscricoesFechamEm",
          "order": "ASCENDING"
        }
      ]
    },
    {
      "//": "'Meus torneios': onde este jogador esta inscrito, em qualquer edicao. [origem: torneios/v1]",
      "collectionGroup": "registrations",
      "queryScope": "COLLECTION_GROUP",
      "fields": [
        {
          "fieldPath": "userId",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "status",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "inscritoEm",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "//": "Lista de participantes da edicao, em ordem de inscricao. [origem: torneios/v1]",
      "collectionGroup": "registrations",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "status",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "inscritoEm",
          "order": "ASCENDING"
        }
      ]
    },
    {
      "//": "Convocacao da lista de espera, em ordem de fila. [origem: torneios/v1]",
      "collectionGroup": "registrations",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "status",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "posicaoEspera",
          "order": "ASCENDING"
        }
      ]
    },
    {
      "//": "Mesas de uma fase, para saber se a fase pode ser apurada. [origem: torneios/v1]",
      "collectionGroup": "tables",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "faseId",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "status",
          "order": "ASCENDING"
        }
      ]
    },
    {
      "//": "Resultados de uma fase, insumo da classificacao. [origem: torneios/v1]",
      "collectionGroup": "results",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "faseId",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "encerradaEm",
          "order": "ASCENDING"
        }
      ]
    },
    {
      "//": "Classificacao da edicao, ja ordenada por posicao. [origem: torneios/v1]",
      "collectionGroup": "standings",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "faseId",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "posicao",
          "order": "ASCENDING"
        }
      ]
    },
    {
      "//": "Historico de um jogador, do mais recente para o mais antigo. [origem: torneios/v1]",
      "collectionGroup": "tournamentHistory",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "participantesUserIds",
          "arrayConfig": "CONTAINS"
        },
        {
          "fieldPath": "encerramento",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "//": "Historico de um torneio por temporada (edicoes realizadas). [origem: torneios/v1]",
      "collectionGroup": "tournamentHistory",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "tournamentId",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "temporada",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "numeroEdicao",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "//": "Recompensas ativas de um jogador (OS 02 secao 13). [origem: torneios/v1]",
      "collectionGroup": "rewardGrants",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "userId",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "grantedAt",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "//": "Classificados ao encerramento anual, por temporada e por jogador. Sustenta a consolidacao de convites e a lista de excedentes (OS 02 secao 17). [origem: torneios/v1]",
      "collectionGroup": "annualQualifications",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "temporada",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "userId",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "registradoEm",
          "order": "ASCENDING"
        }
      ]
    },
    {
      "//": "Painel administrativo dos convites da temporada. [origem: torneios/v1]",
      "collectionGroup": "closingInvites",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "temporada",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "status",
          "order": "ASCENDING"
        }
      ]
    }
  ],
  "fieldOverrides": []
}
