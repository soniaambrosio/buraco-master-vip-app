{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://buracomastervip.com/contratos/fato-partida-oficial-v1.schema.json",
  "title": "FatoPartidaOficialV1",
  "x-versaoContrato": 1,
  "x-autoridade": "Este envelope é a ÚNICA entrada autorizada do futuro escritor das estatísticas oficiais do Perfil. Ele não liga nada: nesta versão não existe produtor nem consumidor em produção. A implementação de referência, e a autoridade em caso de divergência, é functions-ranking/src/estatisticas/contrato.ts.",
  "x-vocabulario": "A enumeração de modalidade é FECHADA e não aceita os vocabulários existentes como equivalentes silenciosos. O servidor Node fala publica|privada|simulada e o envelope atual carrega tipoPartida:'publica', que não distingue casual de ranqueada; o domínio Dart fala publica_casual|publica_ranqueada|privada|torneio|treinamento|contra_robos. Traduzir é trabalho do PRODUTOR, na próxima OS. Símbolo desconhecido é recusado.",
  "x-invariantesNaoExpressaveis": [
    "Os quatro assentos devem ser exatamente 0, 1, 2 e 3, sem repetição.",
    "uid e publicPlayerId não podem se repetir entre os quatro participantes.",
    "houveSubstituicaoPorBot deve ser igual a 'algum participante tem substituidoPorBot true'.",
    "Estes três são conferidos por functions-ranking/src/estatisticas/contrato.ts e por functions-ranking/test/estatisticas.test.js, e não por este arquivo."
  ],
  "type": "object",
  "additionalProperties": false,
  "required": [
    "versaoContrato",
    "matchId",
    "eventoId",
    "encerradaEm",
    "modalidade",
    "estadoTerminal",
    "encerramentoAutoritativo",
    "ambienteCompetitivo",
    "empate",
    "ladoVencedor",
    "equipes",
    "participantes",
    "houveSubstituicaoPorBot",
    "origem"
  ],
  "properties": {
    "versaoContrato": {
      "description": "Versão explícita do contrato. Qualquer outro valor é recusado, e não lido na melhor das hipóteses.",
      "const": 1
    },
    "matchId": {
      "description": "Identidade ESTÁVEL da partida. Reconexão não a muda.",
      "$ref": "#/$defs/identificador"
    },
    "eventoId": {
      "description": "Identidade da AFIRMAÇÃO. Duas entregas do mesmo desfecho têm matchId igual e eventoId diferente.",
      "$ref": "#/$defs/identificador"
    },
    "encerradaEm": {
      "description": "Instante autoritativo do encerramento, ISO 8601 em UTC com Z explícito.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$"
    },
    "modalidade": {
      "description": "Natureza da mesa. Enumeração fechada. Somente publica_casual e publica_ranqueada produzem estatística oficial na V1; as outras quatro são CONHECIDAS e INELEGÍVEIS — o envelope é válido e simplesmente não gera delta. torneio está na lista porque a mesa existe e o produtor tem de conseguir relatá-la: deixá-la de fora a transformaria num símbolo desconhecido, que recusa o envelope inteiro e merece alarme.",
      "enum": ["publica_casual", "publica_ranqueada", "torneio", "privada", "treino", "simulada"]
    },
    "estadoTerminal": {
      "description": "Estado terminal da partida. Somente concluida produz estatística na V1; abandonada fica de fora porque o registro não identifica QUEM abandonou.",
      "enum": ["concluida", "cancelada", "abandonada"]
    },
    "encerramentoAutoritativo": {
      "description": "A partida foi encerrada pela autoridade da partida? Desfecho observado, remontado ou inferido é false, e não produz estatística.",
      "type": "boolean"
    },
    "ambienteCompetitivo": {
      "description": "Redundante com propósito: tem de ser exatamente (modalidade === 'publica_ranqueada'). A redundância é uma trava contra o produtor que marque mesa casual como competitiva. TORNEIO é false aqui: a pergunta é a de AMBIENTE_COMPETITIVO (functions-ranking/src/competicao.ts:106) — 'esta mesa alimenta o rating de temporada?' —, e a §6 da Política Competitiva v1 respondeu que torneio não alimenta, ainda que valha ledger.",
      "type": "boolean"
    },
    "empate": {
      "description": "true exatamente quando ladoVencedor é null.",
      "type": "boolean"
    },
    "ladoVencedor": {
      "description": "O lado que venceu, ou null no empate.",
      "type": ["string", "null"],
      "enum": ["nos", "eles", null]
    },
    "equipes": {
      "description": "O que cada dupla fez. Canastra é fato DA DUPLA: não há autoria individual em lugar nenhum do sistema.",
      "type": "object",
      "additionalProperties": false,
      "required": ["nos", "eles"],
      "properties": {
        "nos": { "$ref": "#/$defs/resultadoDaEquipe" },
        "eles": { "$ref": "#/$defs/resultadoDaEquipe" }
      }
    },
    "participantes": {
      "description": "Os quatro assentos da mesa. Buraco em dupla senta 0, 1, 2 e 3.",
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/participante" }
    },
    "houveSubstituicaoPorBot": {
      "description": "Houve substituição definitiva por robô em algum assento? Torna a partida inelegível para as estatísticas públicas desta versão.",
      "type": "boolean"
    },
    "origem": { "$ref": "#/$defs/origem" }
  },
  "allOf": [
    {
      "if": { "properties": { "modalidade": { "const": "publica_ranqueada" } }, "required": ["modalidade"] },
      "then": { "properties": { "ambienteCompetitivo": { "const": true } } },
      "else": { "properties": { "ambienteCompetitivo": { "const": false } } }
    },
    {
      "if": { "properties": { "empate": { "const": true } }, "required": ["empate"] },
      "then": { "properties": { "ladoVencedor": { "const": null } } },
      "else": { "properties": { "ladoVencedor": { "enum": ["nos", "eles"] } } }
    }
  ],
  "$defs": {
    "identificador": {
      "description": "Identificador estável, sem marca de demonstração, teste ou fixture. A barreira pelo nome é grosseira de propósito: o alvo são os demo-... e teste-... de fixture, e não um adversário — contra esse quem vale é o claim motorDePartidas.",
      "type": "string",
      "minLength": 8,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_-]+$",
      "not": {
        "pattern": "^([Dd][Ee][Mm][Oo]|[Tt][Ee][Ss][Tt]|[Mm][Oo][Cc][Kk]|[Ee][Xx][Ee][Mm][Pp][Ll][Oo]|[Ss][Aa][Mm][Pp][Ll][Ee]|[Ff][Ii][Xx][Tt][Uu][Rr][Ee]|[Ff][Aa][Kk][Ee])"
      }
    },
    "resultadoDaEquipe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pontos", "canastrasLimpas", "canastrasSujas"],
      "properties": {
        "pontos": {
          "description": "Pontos da dupla. Inteiro, podendo ser negativo — o Buraco pune.",
          "type": "integer"
        },
        "canastrasLimpas": { "type": "integer", "minimum": 0 },
        "canastrasSujas": {
          "description": "Guardada SEPARADA da limpa; o total é derivado. A distinção já existe no motor (app/lib/mesa.dart:380 e :509) mas para no Jogo: LadoDaMesa só propaga canastrasLimpas. Passar a emiti-la é trabalho do produtor.",
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "participante": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uid", "publicPlayerId", "equipe", "assento", "classe", "substituidoPorBot"],
      "properties": {
        "uid": {
          "description": "Identidade INTERNA. Só atravessa a fronteira protegida do backend; nunca é publicada. O delta produzido pelo redutor não a carrega.",
          "type": "string",
          "minLength": 1
        },
        "publicPlayerId": {
          "description": "Identidade PÚBLICA, no formato canônico emitido por functions-social: prefixo P e 12 símbolos do base32 de Crockford sem I, L, O e U.",
          "type": "string",
          "pattern": "^P[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{12}$"
        },
        "equipe": { "enum": ["nos", "eles"] },
        "assento": {
          "description": "0 a 3. A lei da mesa liga assento e equipe e não é parametrizável: pares são nos, ímpares são eles.",
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "classe": { "enum": ["humano", "robo"] },
        "substituidoPorBot": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": { "properties": { "assento": { "enum": [0, 2] } }, "required": ["assento"] },
          "then": { "properties": { "equipe": { "const": "nos" } } },
          "else": { "properties": { "equipe": { "const": "eles" } } }
        }
      ]
    },
    "origem": {
      "description": "Quem tem autoridade para afirmar este fato. Espelha o claim exigido por registrarEncerramentoPartida: motorDePartidas ou admin. Cliente autenticado comum não está na lista.",
      "type": "object",
      "additionalProperties": false,
      "required": ["autoridade", "instancia"],
      "properties": {
        "autoridade": { "enum": ["motorDePartidas", "admin"] },
        "instancia": { "type": "string", "minLength": 1 }
      }
    }
  },
