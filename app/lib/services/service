// configuracoes_service.dart — persistência REAL das preferências do app.
// Fonte hoje: SharedPreferences (local, sobrevive a reinícios). Sincronização
// com servidor/Firebase entra numa fatia futura sem mudar esta API.
// Também é a fonte que o JOGO lê pra aplicar as preferências (ex.: som).

import 'package:shared_preferences/shared_preferences.dart';
import '../screens/configuracoes_screen.dart'
    show Configuracoes, MaoDominante, QuemMeConvida, Idioma;

class ConfiguracoesService {
  ConfiguracoesService._();
  static final ConfiguracoesService instance = ConfiguracoesService._();

  static const _kMusica = 'cfg_musica';
  static const _kEfeitos = 'cfg_efeitos';
  static const _kVibracao = 'cfg_vibracao';
  static const _kNotificacoes = 'cfg_notificacoes';
  static const _kAnimacoes = 'cfg_animacoes';
  static const _kOrdenar = 'cfg_ordenar';
  static const _kConfirmar = 'cfg_confirmar';
  static const _kMao = 'cfg_mao';
  static const _kConvida = 'cfg_convida';
  static const _kChatMaiores = 'cfg_chat_maiores';
  static const _kOnline = 'cfg_online';
  static const _kIdioma = 'cfg_idioma';

  // Cache em memória — o jogo pode ler sem await depois de carregado uma vez.
  Configuracoes _atual = const Configuracoes();
  Configuracoes get atual => _atual;

  int _idxSeguro(int? v, int max) => (v ?? 0).clamp(0, max - 1);

  /// Carrega do disco (ou defaults). Chamar uma vez ao abrir as Configurações
  /// e no início do app (pra o jogo já ter os valores em memória).
  Future<Configuracoes> carregar({String versaoApp = ''}) async {
    final p = await SharedPreferences.getInstance();
    const d = Configuracoes();
    _atual = Configuracoes(
      musica: p.getBool(_kMusica) ?? d.musica,
      efeitosSonoros: p.getBool(_kEfeitos) ?? d.efeitosSonoros,
      vibracao: p.getBool(_kVibracao) ?? d.vibracao,
      notificacoes: p.getBool(_kNotificacoes) ?? d.notificacoes,
      animacoes: p.getBool(_kAnimacoes) ?? d.animacoes,
      ordenarCartasAuto: p.getBool(_kOrdenar) ?? d.ordenarCartasAuto,
      confirmarDescarte: p.getBool(_kConfirmar) ?? d.confirmarDescarte,
      maoDominante:
          MaoDominante.values[_idxSeguro(p.getInt(_kMao), MaoDominante.values.length)],
      quemMeConvida:
          QuemMeConvida.values[_idxSeguro(p.getInt(_kConvida), QuemMeConvida.values.length)],
      chatPublicoSoMaiores: p.getBool(_kChatMaiores) ?? d.chatPublicoSoMaiores,
      mostrarOnline: p.getBool(_kOnline) ?? d.mostrarOnline,
      idioma: Idioma.values[_idxSeguro(p.getInt(_kIdioma), Idioma.values.length)],
      versaoApp: versaoApp,
    );
    return _atual;
  }

  /// Persiste o estado inteiro (chamado a cada mudança na tela).
  Future<void> salvar(Configuracoes c) async {
    _atual = c;
    final p = await SharedPreferences.getInstance();
    await p.setBool(_kMusica, c.musica);
    await p.setBool(_kEfeitos, c.efeitosSonoros);
    await p.setBool(_kVibracao, c.vibracao);
    await p.setBool(_kNotificacoes, c.notificacoes);
    await p.setBool(_kAnimacoes, c.animacoes);
    await p.setBool(_kOrdenar, c.ordenarCartasAuto);
    await p.setBool(_kConfirmar, c.confirmarDescarte);
    await p.setInt(_kMao, c.maoDominante.index);
    await p.setInt(_kConvida, c.quemMeConvida.index);
    await p.setBool(_kChatMaiores, c.chatPublicoSoMaiores);
    await p.setBool(_kOnline, c.mostrarOnline);
    await p.setInt(_kIdioma, c.idioma.index);
  }
}
